---
import { CloudOff, Cpu, Database, PanelTop, SquareTerminal, Terminal } from "@lucide/astro";
import "./RuntimeArchitecture.scss";

const clients = [
  { id: "tui", name: "crona-tui", role: "terminal", Icon: SquareTerminal },
  { id: "cli", name: "crona", role: "cli", Icon: Terminal },
  { id: "mac", name: "crona-mac", role: "menu bar", Icon: PanelTop },
];
---

<figure class="runtime-arch" aria-labelledby="runtime-arch-caption">
  <div class="runtime-arch__machine">
    <span class="runtime-arch__machine-label">your machine</span>

    <div class="runtime-arch__clients">
      {
        clients.map(({ id, name, role, Icon }) => (
          <div class:list={["runtime-arch__node", `runtime-arch__node--${id}`]}>
            <Icon class="runtime-arch__icon" size={16} aria-hidden="true" />
            <strong>{name}</strong>
            <span>{role}</span>
          </div>
        ))
      }
    </div>

    <!-- Clients join one bus into the daemon; sparks replay a CLI write fanning out. -->
    <div class="runtime-arch__links" aria-hidden="true">
      <span class="runtime-arch__link runtime-arch__link--tui"></span>
      <span class="runtime-arch__link runtime-arch__link--cli"></span>
      <span class="runtime-arch__link runtime-arch__link--mac"></span>
      <span class="runtime-arch__link runtime-arch__link--bus-left"></span>
      <span class="runtime-arch__link runtime-arch__link--bus-right"></span>
      <span class="runtime-arch__label runtime-arch__label--ipc">local socket · IPC</span>
    </div>

    <div class="runtime-arch__node runtime-arch__node--daemon">
      <Cpu class="runtime-arch__icon" size={16} aria-hidden="true" />
      <strong>crona-daemon</strong>
      <span>one source of truth</span>
    </div>

    <div class="runtime-arch__links runtime-arch__links--storage" aria-hidden="true">
      <span class="runtime-arch__link runtime-arch__link--storage"></span>
      <span class="runtime-arch__label runtime-arch__label--storage">reads · writes</span>
    </div>

    <div class="runtime-arch__node runtime-arch__node--storage">
      <Database class="runtime-arch__icon" size={16} aria-hidden="true" />
      <strong>sqlite</strong>
      <span>local record</span>
    </div>
  </div>

  <figcaption class="runtime-arch__caption" id="runtime-arch-caption">
    <CloudOff size={14} aria-hidden="true" />
    <span>Nothing leaves your machine. No cloud sync, no account.</span>
  </figcaption>
</figure>
