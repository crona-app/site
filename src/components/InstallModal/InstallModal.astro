---
import { installDocsUrl, installPlatforms, packageManagers, runCommand } from "../../data/install";

interface Props {
  latestVersion?: string;
}

const { latestVersion } = Astro.props;
---

<div class="install-modal" data-install-modal hidden>
  <div class="install-modal__backdrop" data-install-close></div>
  <section
    class="install-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="install-modal-title"
    aria-describedby="install-modal-description"
    tabindex="-1"
  >
    <div class="install-modal__topline">
      <div><h2 id="install-modal-title">Install Crona</h2></div>
      <button
        class="install-modal__close"
        type="button"
        aria-label="Close installation instructions"
        data-install-close>×</button
      >
    </div>
    <p class="install-modal__description" id="install-modal-description">
      {
        latestVersion ? (
          <>
            Installs the latest stable release, <span class="install-modal__version">{latestVersion}</span>.
          </>
        ) : (
          "Installs the latest stable release for your platform."
        )
      }
    </p>
    <div class="install-modal__tabs" role="tablist" aria-label="Installation platform">
      {
        installPlatforms.map((platform, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`install-panel-${platform.id}`}
            id={`install-tab-${platform.id}`}
            data-install-platform={platform.id}
          >
            {platform.label}
          </button>
        ))
      }
    </div>
    <div class="install-modal__panels">
      {
        installPlatforms.map((platform, index) => {
          const manager = packageManagers[platform.manager];
          return (
            <div
              class="install-modal__panel"
              role="tabpanel"
              id={`install-panel-${platform.id}`}
              aria-labelledby={`install-tab-${platform.id}`}
              data-install-panel={platform.id}
              hidden={index !== 0}
            >
              <ol class="install-modal__steps">
                <li>
                  <p>Install with {manager.label}:</p>
                  <div class="install-modal__command">
                    <div class="install-modal__command-line">
                      {manager.install.map((line) => (
                        <code>{line}</code>
                      ))}
                    </div>
                    <button type="button" data-install-copy>
                      [ copy ]
                    </button>
                  </div>
                </li>
                <li>
                  <p>Start it. The daemon starts on its own the first time.</p>
                  <div class="install-modal__command">
                    <div class="install-modal__command-line">
                      <code>{runCommand}</code>
                    </div>
                    <button type="button" data-install-copy>
                      [ copy ]
                    </button>
                  </div>
                </li>
              </ol>
              <div class="install-modal__note">
                <p>Includes: crona · crona-tui · crona-daemon</p>
                <p>
                  Update later with <code>{manager.update}</code>
                </p>
              </div>
              {platform.alternative && (
                <a class="install-modal__companion" href={platform.alternative.href} rel="noreferrer">
                  {platform.alternative.text}
                  <span aria-hidden="true">→</span>
                </a>
              )}
              {platform.id === "macos" && (
                <a class="install-modal__companion" href="/mac/">
                  Want quick access from the menu bar? Get the companion
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          );
        })
      }
    </div>
    <div class="install-modal__footer">
      <a href={installDocsUrl} rel="noreferrer">Other ways to install<span aria-hidden="true">→</span></a>
      <span class="install-modal__status" role="status" aria-live="polite" data-install-status></span>
    </div>
  </section>
</div>

<script>
  const modal = document.querySelector("[data-install-modal]");
  const openButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-install-open]")];

  if (modal instanceof HTMLElement && openButtons.length) {
    const dialog = modal.querySelector<HTMLElement>("[role=dialog]");
    const closeButtons = [...modal.querySelectorAll<HTMLButtonElement>("[data-install-close]")];
    const tabs = [...modal.querySelectorAll<HTMLButtonElement>("[data-install-platform]")];
    const panels = [...modal.querySelectorAll<HTMLElement>("[data-install-panel]")];
    const copyButtons = [...modal.querySelectorAll<HTMLButtonElement>("[data-install-copy]")];
    const status = modal.querySelector<HTMLElement>("[data-install-status]");
    const installLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[href="/#install"]')];
    const validPlatforms = new Set(tabs.map((tab) => tab.dataset.installPlatform ?? ""));
    let returnFocus: HTMLElement | undefined = openButtons[0] as HTMLElement | undefined;

    const detectedPlatform = () => {
      const userAgent = navigator.userAgent.toLowerCase();
      if (userAgent.includes("windows")) return "windows";
      if (userAgent.includes("linux") && !userAgent.includes("android")) return "linux";
      return "macos";
    };

    const platformFromHash = () => {
      const value = window.location.hash.replace(/^#install-?/, "").toLowerCase();
      return validPlatforms.has(value) ? value : detectedPlatform();
    };

    const setPlatform = (platform: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.installPlatform === platform;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.installPanel !== platform;
      });
    };

    const announce = (message: string) => {
      if (status) status.textContent = message;
    };

    const openModal = (platform = platformFromHash(), shouldUpdateHash = true) => {
      const next = validPlatforms.has(platform) ? platform : detectedPlatform();
      if (modal.hidden)
        returnFocus =
          document.activeElement instanceof HTMLElement ? document.activeElement : openButtons[0];
      setPlatform(next);
      if (modal.hidden) {
        modal.hidden = false;
        document.body.classList.add("has-install-modal");
        dialog?.focus();
      }
      if (shouldUpdateHash) window.history.replaceState(null, "", `#install-${next}`);
    };

    const closeModal = (shouldClearHash = true) => {
      modal.hidden = true;
      document.body.classList.remove("has-install-modal");
      announce("");
      returnFocus?.focus();
      if (shouldClearHash && window.location.hash.startsWith("#install"))
        window.history.replaceState(null, "", window.location.pathname + window.location.search);
    };

    // Keep Tab inside the dialog while it is open.
    const focusable = () =>
      [
        ...(dialog?.querySelectorAll<HTMLElement>(
          'button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])',
        ) ?? []),
      ].filter((element) => element.offsetParent !== null && element.tabIndex >= 0);

    const trapFocus = (event: KeyboardEvent) => {
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (event.shiftKey && (active === first || active === dialog)) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !dialog?.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    };

    // Clipboard can be missing (http, older browsers); select the text so it can be copied by hand.
    const selectText = (element: Element) => {
      const range = document.createRange();
      range.selectNodeContents(element);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
    };

    openButtons.forEach((button) => button.addEventListener("click", () => openModal()));
    installLinks.forEach((link) =>
      link.addEventListener("click", (event) => {
        event.preventDefault();
        openModal();
      }),
    );
    closeButtons.forEach((button) => button.addEventListener("click", () => closeModal()));
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => openModal(tab.dataset.installPlatform));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const current = tabs.indexOf(tab);
        const next =
          event.key === "ArrowRight"
            ? (current + 1) % tabs.length
            : (current - 1 + tabs.length) % tabs.length;
        tabs[next].focus();
        openModal(tabs[next].dataset.installPlatform);
      });
    });
    copyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const lines = button.closest(".install-modal__command")?.querySelector(".install-modal__command-line");
        if (!lines) return;
        const command = [...lines.querySelectorAll("code")]
          .map((code) => code.textContent?.trim() ?? "")
          .join("\n");
        try {
          if (!navigator.clipboard) throw new Error("Clipboard unavailable");
          await navigator.clipboard.writeText(command);
          button.textContent = "[ copied ]";
          announce("Copied to clipboard.");
          window.setTimeout(() => {
            button.textContent = "[ copy ]";
          }, 1600);
        } catch {
          selectText(lines);
          announce("Couldn't copy automatically. The command is selected; press ⌘C or Ctrl+C.");
        }
      });
    });
    document.addEventListener("keydown", (event) => {
      if (!modal.hidden) {
        if (event.key === "Escape") closeModal();
        if (event.key === "Tab") trapFocus(event);
        return;
      }
      if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      if (
        event.target instanceof HTMLElement &&
        (["INPUT", "TEXTAREA", "SELECT"].includes(event.target.tagName) ||
          event.target.isContentEditable)
      )
        return;
      if (event.key.toLowerCase() === "i") {
        event.preventDefault();
        openModal();
      }
      if (event.key.toLowerCase() === "d") window.location.href = "https://docs.crona.work/";
    });
    window.addEventListener("hashchange", () => {
      if (window.location.hash.startsWith("#install")) openModal(platformFromHash(), false);
      else if (!modal.hidden) closeModal(false);
    });
    if (window.location.hash.startsWith("#install")) openModal(platformFromHash(), false);
  }
</script>
