---
interface Props {
  description: string;
  label: string;
  variant: string;
  /** Landing stack only: render as a button that brings this view to the front. */
  select?: number;
  pressed?: boolean;
}

const { description, label, variant, select, pressed = false } = Astro.props as Props;
const classes = ["home-workspace-screen__card", `home-workspace-screen__card--${variant}`];
---

{
  select === undefined ? (
    <div class:list={classes}>
      <span class="home-workspace-screen__key">{label}</span>
      <p>{description}</p>
    </div>
  ) : (
    <button
      class:list={classes}
      type="button"
      data-workspace-select={select}
      aria-pressed={pressed ? "true" : "false"}
      style={`view-transition-name: workspace-card-${variant}`}
    >
      <span class="home-workspace-screen__key">{label}</span>
      <p>{description}</p>
    </button>
  )
}
