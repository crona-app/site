---
import { installMethods } from "../../data/install";
import type { MacRelease } from "../../lib/mac-releases";

interface Props {
  stable: MacRelease;
  beta?: MacRelease | null;
  releasesUrl: string;
}

const { stable, beta, releasesUrl } = Astro.props as Props;
const stableUrl = stable.downloadUrl ?? stable.releaseUrl;
const stableLabel = stable.downloadUrl ? `Download ${stable.version}` : `View ${stable.version}`;
const brewInstall = installMethods.find((method) => method.id === "brew")?.install[0];
const dmgName = stable.downloadUrl?.split("/").pop();
---

<section class="mac-download" id="download" aria-labelledby="download-title">
  <div class="mac-download__intro">
    <h2 id="download-title">Get Crona for Mac.</h2>
    <p>The Mac app works alongside Crona core. Install Crona first, then add the Mac app.</p>
    <ol class="mac-download__steps">
      <li>
        <span>01 / Crona</span>
        <strong>Install Crona</strong>
        <p>This sets up the local daemon shared by the TUI, CLI, and Mac app.</p>
        <div class="mac-download__command">
          <code>{brewInstall}</code>
          <button type="button" data-mac-copy={brewInstall}>Copy</button>
        </div>
        <p>
          No Homebrew? <a href="/#install-sh">See the other install options</a>.
        </p>
      </li>
      <li>
        <span>02 / Mac app</span>
        <strong>Install the Mac App</strong>
        <p>
          Download {dmgName ? <code>{dmgName}</code> : "the DMG"}, move Crona to Applications, and
          launch it.
        </p>
      </li>
    </ol>
    <a
      class="mac-text-link mac-download__guide"
      href="https://docs.crona.work/workflows/macos-companion/"
      >Read the install guide <span aria-hidden="true">↗</span></a
    >
  </div>
  <div class="mac-download__aside">
    <span class="mac-download__release-label">Stable release</span>
    <strong>{stable.version}</strong>
    <span>macOS 14+ · Universal DMG</span>
    <a class="mac-button" href={stableUrl} rel="noreferrer"
      >{stableLabel}<span aria-hidden="true">↗</span></a
    >
    {
      beta && (
        <a class="mac-download__beta" href={beta.downloadUrl ?? beta.releaseUrl} rel="noreferrer">
          Try latest beta · {beta.version}
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
    <a class="mac-download__release-link" href={releasesUrl} rel="noreferrer"
      >View release notes <span aria-hidden="true">↗</span></a
    >
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-mac-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.macCopy ?? "");
        button.textContent = "Copied";
      } catch {
        // No clipboard (http, older browsers): select the command so it can be copied by hand.
        const code = button.previousElementSibling;
        if (code) window.getSelection()?.selectAllChildren(code);
        button.textContent = "Press ⌘C";
      }
      window.setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  });
</script>
